      "!**/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/node_modules/node-pty/prebuilds/darwin-*/**",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/node-pty/{src,deps,third_party}/**",
      "pwa/**/*"
    ],
    "asarUnpack": [
      ".agents/skills/satr-guide/**/*",
      ".agents/skills/satr-diverge/**/*",
      ".agents/skills/satr-generate/**/*",
      ".agents/skills/satr-accept/**/*",
      ".agents/skills/satr-design-ar/**/*",
      ".agents/skills/satr-youtube/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appx": {
      "identityName": "Moxa.Satr",
      "publisher": "CN=3016A96C-A16E-463B-BCE8-54F46BF3D5D8",
      "publisherDisplayName": "Moxa",
      "applicationId": "Satr",
      "displayName": "سطر — Satr",
      "backgroundColor": "#151B23",
      "languages": [
        "ar-SA",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سطر — Satr",
      "uninstallDisplayName": "سطر — Satr",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "ar_SA"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.176",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "electron": true,
    "node-pty": true
  }
