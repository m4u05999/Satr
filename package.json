  "build": {
    "appId": "ai.satr.app",
    "productName": "Satr",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "m4u05999",
        "repo": "Satr"
      }
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      ".agents/skills/satr-guide/**/*",
      ".agents/skills/satr-diverge/**/*",
      ".agents/skills/satr-generate/**/*",
      ".agents/skills/satr-accept/**/*",
      ".agents/skills/satr-design-ar/**/*",
      ".agents/skills/satr-youtube/**/*",
