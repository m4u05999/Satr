{
  "name": "satr",
  "productName": "Satr",
  "version": "2.5.0",
  "description": "سطر — تطبيق سطح مكتب عربي لأدوات الذكاء الاصطناعي في سطر الأوامر (Claude Code وغيرها) بدعم RTL كامل",
  "main": "electron/main.js",
  "author": "Moxa",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/update-csp.js",
    "start": "electron .",
    "predist": "node scripts/update-csp.js",
    "dist": "electron-builder --win",
    "predist:dir": "node scripts/update-csp.js",
    "dist:dir": "electron-builder --win --dir",
    "predist:ee": "node scripts/update-csp.js",
    "dist:ee": "electron-builder --win --config scripts/ee-builder-config.js"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ai.satr.app",
    "productName": "Satr",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "m4u05999",
        "repo": "Satr"
      }
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "!enterprise/**",
      "!**/@anthropic-ai/claude-agent-sdk-win32-x64/**",
      "!**/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/node_modules/node-pty/prebuilds/darwin-*/**",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/node-pty/{src,deps,third_party}/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سطر — Satr",
      "uninstallDisplayName": "سطر — Satr",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "ar_SA"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.176",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  }
}
