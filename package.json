    "dist": "electron-builder --win",
    "predist:dir": "node scripts/update-csp.js",
    "dist:dir": "electron-builder --win --dir",
    "predist:ee": "node scripts/update-csp.js",
    "dist:ee": "electron-builder --win --config scripts/ee-builder-config.js --publish never",
