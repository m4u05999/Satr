  "devDependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25"
  },
  "build": {
    "appId": "ai.satr.app",
    "productName": "Satr",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "m4u05999",
        "repo": "Satr"
      }
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      ".agents/skills/satr-guide/**/*",
      ".agents/skills/satr-diverge/**/*",
      "!enterprise/**",
      "!**/@anthropic-ai/claude-agent-sdk-win32-x64/**",
      "!**/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/node_modules/node-pty/prebuilds/darwin-*/**",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**",
      "!**/node_modules/node-pty/{src,deps,third_party}/**"
    ],
    "asarUnpack": [
      ".agents/skills/satr-guide/**/*",
      ".agents/skills/satr-diverge/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سطر — Satr",
      "uninstallDisplayName": "سطر — Satr",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "ar_SA"
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.176",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  }
}
